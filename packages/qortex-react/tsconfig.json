{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "qortex-core": [
        "../qortex-core/src"
      ],
      "qortex-core/persister": [
        "../qortex-core/src/persister-export"
      ]
    }
  },
  "include": [
    "src"
  ]
}