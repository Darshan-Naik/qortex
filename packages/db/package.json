{
    "name": "qortex-db",
    "version": "2.1.0",
    "description": "Browser-only Redis-like key-value database with localStorage, sessionStorage, and IndexedDB support",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./query": {
            "types": "./dist/query.d.ts",
            "import": "./dist/query.mjs",
            "require": "./dist/query.js"
        },
        "./store": {
            "types": "./dist/store.d.ts",
            "import": "./dist/store.mjs",
            "require": "./dist/store.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "clean": "rm -rf dist",
        "prepare": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Darshan-Naik/qortex.git"
    },
    "homepage": "https://qortex.darshannaik.com",
    "bugs": {
        "url": "https://github.com/Darshan-Naik/qortex/issues"
    },
    "keywords": [
        "qortex",
        "database",
        "key-value",
        "localStorage",
        "sessionStorage",
        "indexedDB",
        "browser",
        "typescript"
    ],
    "author": "Darshan Naik",
    "license": "LGPL-3.0",
    "devDependencies": {
        "tsup": "^6.0.0",
        "typescript": "^5.0.0"
    }
}