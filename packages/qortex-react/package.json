{
  "name": "qortex-react",
  "version": "0.3.4",
  "description": "React hook bridge for qortex runtime",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./persister": {
      "types": "./dist/persister.d.ts",
      "import": "./dist/persister.mjs",
      "require": "./dist/persister.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darshan-Naik/qortex.git"
  },
  "homepage": "https://qortex.darshannaik.com",
  "bugs": {
    "url": "https://github.com/Darshan-Naik/qortex/issues"
  },
  "keywords": [
    "qortex",
    "react",
    "useQuery",
    "cache",
    "mfe",
    "data-fetching",
    "typescript"
  ],
  "author": "Darshan Naik",
  "license": "LGPL-3.0",
  "dependencies": {
    "qortex-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "tsup": "^6.0.0",
    "typescript": "^5.0.0"
  }
}
