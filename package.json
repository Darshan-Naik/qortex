{
  "name": "d-query-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "A minimal, performant data fetching library with React integration",
  "repository": {
    "type": "git",
    "url": "https://github.com/Darshan-Naik/d-query.git"
  },
  "homepage": "https://github.com/Darshan-Naik/d-query#readme",
  "bugs": {
    "url": "https://github.com/Darshan-Naik/d-query/issues"
  },
  "keywords": [
    "d-query",
    "query",
    "cache",
    "react",
    "data-fetching",
    "typescript"
  ],
  "author": "Darshan Naik",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build:packages": "pnpm -w -r --filter './packages/*' run build",
    "bootstrap": "pnpm install",
    "dev:example": "pnpm --filter d-query-react-example --parallel run dev",
    "publish:d-query": "pnpm --filter d-query publish --access public",
    "publish:d-query-react": "pnpm --filter d-query-react publish --access public",
    "publish:packages": "pnpm -w -r --filter './packages/*' run build && pnpm -w -r --filter './packages/*' publish --access public"
  }
}