{
  "name": "qortex",
  "private": true,
  "version": "0.3.1",
  "description": "A minimal, performant data fetching library with React integration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darshan-Naik/qortex.git"
  },
  "homepage": "https://qortex.darshannaik.com",
  "bugs": {
    "url": "https://github.com/Darshan-Naik/qortex/issues"
  },
  "keywords": [
    "qortex",
    "query",
    "cache",
    "react",
    "data-fetching",
    "typescript"
  ],
  "author": "Darshan Naik",
  "license": "LGPL-3.0",
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/preset-env": "^7.0.0",
    "@babel/preset-react": "^7.0.0",
    "@babel/preset-typescript": "^7.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "babel-jest": "^29.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build:packages": "pnpm -w -r --filter './packages/*' run build",
    "bootstrap": "pnpm install",
    "dev:example": "pnpm --filter qortex-react-example --parallel run dev",
    "dev:docs": "pnpm --filter qortex-docs run dev",
    "build:docs": "pnpm --filter qortex-docs run build",
    "start:docs": "pnpm --filter qortex-docs run start",
    "prepare:publish": "node scripts/prepare-publish.js",
    "publish:qortex-core": "cd packages/qortex-core/dist && npm publish --access public",
    "publish:qortex-react": "cd packages/qortex-react/dist && npm publish --access public",
    "publish:packages": "pnpm run build:packages && pnpm run prepare:publish && pnpm run publish:qortex-core && pnpm run publish:qortex-react",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:packages": "pnpm -w -r --filter './packages/*' run test"
  }
}